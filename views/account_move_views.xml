<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fel_pdf" model="ir.ui.view">
        <field name="name">account.move.form.fel.pdf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="infilefel.infilefel_view_move_form"/>
        <field name="arch" type="xml">
            <field name="fel_numero" position="after">
                <button name="action_extract_fel_identifiers"
                        type="object" string="Leer serie y número del PDF"
                        class="oe_link"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"/>
            </field>
        </field>
    </record>
</odoo>
